# GEMINI_API_KEY: Required for Gemini AI API calls (Maps Grounding & Architectural Imaging).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# OWNER_NOTIFICATION_EMAIL: Recipient email for new property and general inquiries.
OWNER_NOTIFICATION_EMAIL=

# SMTP configuration for Nodemailer inquiry notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Resend API key alternative for inquiry notifications (optional)
RESEND_API_KEY=

# Next.js / Supabase export reference variables (see /docs/SETUP_AND_DEPLOYMENT.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
